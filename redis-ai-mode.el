(defun redis-ai--send-to-redis (stream data)\n  "Send DATA to Redis STREAM."\n  (message "redis-ai--send-to-redis: Called with stream=%s, data=%S" stream data)\n  (condition-case err\n      (progn\n        (let* ((payload (json-encode data))\n               (escaped-payload (replace-regexp-in-string "\\"" \\\\\\"\\"" payload t t))\n               (cmd (format "redis-cli XADD %s * data \"%s\"" stream escaped-payload)))\n          (message "redis-ai--send-to-redis: Payload: %S" payload)\n          (message "redis-ai--send-to-redis: Constructed cmd: %s" cmd)\n          (let ((result (shell-command-to-string cmd)))\n            (message "redis-ai--send-to-redis: Command result: %S" result)\n            result))\n        (when redis-ai-verbose\n          (message "Redis AI: Sent context to %s" stream)))\n    (error\n     (message "Redis AI: Failed to send data: %s" (error-message-string err))\n     )))
